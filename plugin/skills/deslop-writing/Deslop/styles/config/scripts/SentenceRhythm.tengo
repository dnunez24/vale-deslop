// Deslop.SentenceRhythm (W29, adamdunkels/deslop-text): flags 4 consecutive
// sentences whose word counts all fall within 30% of their mean -- the
// metronomic, machine-even cadence AI writing tends toward. Human prose
// varies sentence length; a run of near-identical lengths is a tell.
//
// A sentence shorter than 5 words resets the run (too short to carry a
// rhythm signal), and a blank line -- i.e. a new paragraph -- always resets
// it, since the rhythm has to be continuous prose to count. This prelude
// (strip fenced code, drop headings/list markers, rebuild paragraphs) is
// intentionally duplicated in AnaphoraRun.tengo and StaccatoFragments.tengo
// rather than shared: Vale gives each script its own isolated interpreter.
text := import("text")
matches := []

// Fenced code blocks aren't prose; drop them before paragraph splitting.
document := text.re_replace("(?s)```.*?```", scope, "")
lines := text.split(document, "\n")

// Rebuild paragraphs from non-blank, non-heading, non-list lines. A blank
// line, an ATX heading, or a list marker all break the current paragraph.
paragraphs := []
current := []
for line in lines {
	trimmed := text.trim_space(line)
	is_heading := text.has_prefix(trimmed, "#")
	is_list := text.re_match("^[-*+][ \t]+", trimmed) || text.re_match("^[0-9]+[.)][ \t]+", trimmed)
	if trimmed == "" || is_heading || is_list {
		if len(current) > 0 {
			paragraphs = append(paragraphs, text.join(current, " "))
			current = []
		}
	} else {
		current = append(current, trimmed)
	}
}
if len(current) > 0 {
	paragraphs = append(paragraphs, text.join(current, " "))
}

// Rough sentence boundary: an uppercase opener through the next run of
// terminal punctuation. Not abbreviation-aware, but consistent across the
// four script rules and good enough for a rhythm heuristic.
sentence_pattern := "[A-Z][^.!?]*[.!?]+"

for paragraph in paragraphs {
	found := text.re_find(sentence_pattern, paragraph, -1)
	if found == undefined {
		continue
	}
	run := []
	for m in found {
		sentence := m[0].text
		count := len(text.fields(sentence))
		if count < 5 {
			run = []
			continue
		}
		run = append(run, {text: sentence, count: count})
		if len(run) > 4 {
			run = run[1:]
		}
		if len(run) == 4 {
			sum := run[0].count + run[1].count + run[2].count + run[3].count
			mean := float(sum) / 4.0
			all_within := true
			for r in run {
				diff := float(r.count) - mean
				if diff < 0.0 {
					diff = -diff
				}
				if diff > mean * 0.3 {
					all_within = false
				}
			}
			if all_within {
				last := run[3].text
				start := text.index(scope, last)
				if start != -1 {
					matches = append(matches, {begin: start, end: start + len(last)})
				}
				run = []
			}
		}
	}
}
